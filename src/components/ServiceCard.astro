---
/**
 * Leistung als Feld im Linienraster (wie ein Planausschnitt).
 * Hover/Fokus: Feld füllt sich von unten dunkel, Nummer und Pfeil werden Bronze.
 */
import type { Service } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  index: number;
  headingLevel?: 'h2' | 'h3';
}
const { service, index, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="svc group relative isolate flex flex-col overflow-hidden border border-line bg-white p-6 sm:min-h-[25rem] sm:border-t-0 sm:border-l-0 sm:p-8" style={`--i:${index}`}>
  <span class="svc-fill absolute inset-0 -z-10 bg-ink" aria-hidden="true"></span>

  <div class="flex items-start justify-between">
    <span class="svc-num font-display text-5xl leading-none font-bold text-line transition-colors duration-500 group-hover:text-bronze" aria-hidden="true">
      {String(index + 1).padStart(2, '0')}
    </span>
    <span class="flex size-14 items-center justify-center border border-line text-bronze-700 transition-colors duration-500 group-hover:border-white/15 group-hover:text-bronze">
      <Icon name={service.icon} class="size-8" strokeWidth={1.4} />
    </span>
  </div>

  <H class="mt-10 text-[1.75rem] leading-[1.05] transition-colors duration-500 group-hover:text-white">
    <a href={`/leistungen/${service.slug}/`} class="no-underline after:absolute after:inset-0 focus-visible:outline-none">
      {service.title}
    </a>
  </H>
  <p class="mt-3 text-[0.975rem] leading-relaxed text-muted transition-colors duration-500 group-hover:text-muted-dark">{service.teaser}</p>

  <ul class="mt-5 mb-7 flex flex-wrap gap-x-4 gap-y-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-bronze-700 transition-colors duration-500 group-hover:text-bronze-300" aria-label="Schwerpunkte">
    {service.tags.map((t) => <li class="flex items-center gap-2"><span class="size-1 bg-bronze" aria-hidden="true" />{t}</li>)}
  </ul>

  <div class="mt-auto flex items-center justify-between border-t border-line pt-5 transition-colors duration-500 group-hover:border-white/15">
    <span class="font-display text-sm font-semibold uppercase tracking-[0.18em] transition-colors duration-500 group-hover:text-white" aria-hidden="true">Mehr erfahren</span>
    <span class="svc-arrow flex size-10 items-center justify-center border border-ink transition-all duration-500 group-hover:border-bronze group-hover:bg-bronze group-hover:text-ink" aria-hidden="true">
      <Icon name="arrow" class="size-5 transition-transform duration-500 group-hover:translate-x-0.5" />
    </span>
  </div>
</article>

<style>
  .svc-fill {
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .svc:hover .svc-fill,
  .svc:focus-within .svc-fill {
    transform: scaleY(1);
  }
  /* Tastatur-Fokus: sichtbarer Rahmen um das ganze Feld */
  .svc:has(a:focus-visible) {
    outline: 3px solid var(--color-bronze);
    outline-offset: -3px;
  }
  .svc:focus-within :is(h2, h3, .svc-num) {
    color: #fff;
  }
  .svc:focus-within p {
    color: var(--color-muted-dark);
  }

  /* Einblenden (zentrales data-animate im Grid) */
  :global(.is-armed) .svc {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s ease calc(var(--i) * 110ms),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 110ms);
  }
  :global(.is-active) .svc {
    opacity: 1;
    transform: none;
  }
</style>
