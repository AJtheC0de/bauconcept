---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<div class="vt-mobilebar fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-white/10 bg-ink pb-[env(safe-area-inset-bottom)] md:hidden">
  <a href={site.phone.href} class="flex min-h-14 items-center justify-center gap-2 font-display text-lg font-semibold uppercase tracking-wider text-white no-underline">
    <Icon name="phone" class="size-5 text-bronze" />
    Anrufen
  </a>
  <a href="/kontakt/" class="flex min-h-14 items-center justify-center gap-2 bg-bronze font-display text-lg font-semibold uppercase tracking-wider text-ink no-underline">
    <Icon name="mail" class="size-5" />
    Anfragen
  </a>
</div>
