---
/**
 * Bild oder klar erkennbarer Platzhalter.
 * Mit `image` → optimiertes <Picture> (AVIF/WebP, srcset). Ohne → graue Fläche mit Beschriftung.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  label: string;
  class?: string;
  /** z. B. 'aspect-[4/3]' */
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  dark?: boolean;
}

const {
  image,
  alt = '',
  label,
  class: className = '',
  aspect = 'aspect-[4/3]',
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  eager = false,
  dark = false,
} = Astro.props;
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[400, 640, 960, 1280, 1920].filter((w) => w <= image.width)}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['w-full object-cover', aspect, className]}
      pictureAttributes={{ class: aspect.includes('h-full') ? 'block h-full w-full' : 'block w-full' }}
    />
  ) : (
    <div
      role="img"
      aria-label={`Platzhalter – ${label}`}
      class:list={[
        'relative flex w-full flex-col items-center justify-center gap-2 overflow-hidden p-4 text-center',
        dark ? 'bg-[#3a3a3a] text-muted-dark' : 'bg-ph text-ph-ink',
        aspect,
        className,
      ]}
      style="background-image: repeating-linear-gradient(135deg, transparent 0 22px, rgb(0 0 0 / 0.04) 22px 44px)"
    >
      <Icon name="camera" class="size-8 opacity-70" />
      <span class="font-display text-lg font-semibold uppercase tracking-wide">{label}</span>
      <span class="text-xs font-semibold uppercase tracking-widest opacity-80">Platzhalter</span>
    </div>
  )
}
