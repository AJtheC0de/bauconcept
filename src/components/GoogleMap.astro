---
/**
 * Google-Maps-Karte mit Einwilligung (Kategorie «Externe Medien»).
 * Vorher: stilisierte Karte ohne Verbindung zu Google. Nach Klick/Einwilligung: echtes iframe.
 */
import { site, fullAddress } from '../config/site';
import Icon from './Icon.astro';

const query = encodeURIComponent(`${site.address.street}, ${site.address.zip} ${site.address.city}`);
const embedSrc = `https://www.google.com/maps?q=${query}&output=embed&hl=de`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<div class="gmap relative aspect-[4/5] w-full overflow-hidden bg-stone xs:aspect-[4/3] sm:aspect-[16/10]" data-gmap data-src={embedSrc}>
  <!-- Stilisierte Platzhalter-Karte (reines SVG, keine Daten an Dritte) -->
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="400" height="250" fill="#ebe8e2" />
    <path d="M-20 60 C80 40 140 90 230 70 S360 30 430 50" fill="none" stroke="#fff" stroke-width="14" />
    <path d="M-20 190 C60 170 150 210 250 180 S360 150 430 170" fill="none" stroke="#fff" stroke-width="10" />
    <path d="M120 -10 C130 60 110 140 140 260" fill="none" stroke="#fff" stroke-width="9" />
    <path d="M300 -10 C280 70 310 160 290 260" fill="none" stroke="#fff" stroke-width="7" />
    <path d="M-10 120 L420 110" fill="none" stroke="#fff" stroke-width="5" />
    <path d="M200 0 L215 250" fill="none" stroke="#fff" stroke-width="4" />
    <path d="M330 170 q30 20 80 10 v80 h-90 z" fill="#d8e3d0" />
    <path d="M-10 0 h70 q-10 30 -70 40z" fill="#cfdde6" />
    <g fill="#dedad3">
      <rect x="150" y="85" width="40" height="18" /><rect x="236" y="88" width="46" height="16" /><rect x="152" y="128" width="30" height="36" />
      <rect x="228" y="124" width="54" height="40" /><rect x="40" y="80" width="60" height="24" /><rect x="320" y="70" width="50" height="30" />
    </g>
  </svg>

  <div class="gmap-overlay absolute inset-0 flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white/95 p-5 text-center shadow-xl ring-1 ring-line backdrop-blur-sm sm:p-6">
      <span class="mx-auto flex size-11 items-center justify-center bg-ink text-bronze" aria-hidden="true"><Icon name="pin" class="size-6" /></span>
      <p class="mt-3 font-display text-xl font-bold uppercase">{site.shortName}</p>
      <p class="text-muted">{fullAddress}</p>
      <p class="mt-3 text-xs leading-relaxed text-muted">
        Beim Laden der Karte werden Daten an Google übertragen. <a href="/datenschutz/#google-maps" class="link">Datenschutz</a>
      </p>
      <div class="mt-4 flex flex-col gap-2 xs:flex-row xs:justify-center">
        <button type="button" class="btn-primary min-h-11 px-4 py-2 text-base" data-gmap-load>Karte laden</button>
        <a href={mapsLink} target="_blank" rel="noopener" class="btn-outline-dark min-h-11 px-4 py-2 text-base">
          Route planen <span class="sr-only">(öffnet Google Maps in neuem Fenster)</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { hasConsent, onConsent, readConsent, saveConsent } from '../lib/consent-client';

  document.querySelectorAll<HTMLElement>('[data-gmap]').forEach((box) => {
    const load = () => {
      if (box.querySelector('iframe')) return;
      const f = document.createElement('iframe');
      f.src = box.dataset.src!;
      f.title = 'Karte: Standort Bau Concept Schweiz, Ibelweg 18A, Zug';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'absolute inset-0 h-full w-full border-0';
      f.setAttribute('allowfullscreen', '');
      box.append(f);
      box.querySelector('.gmap-overlay')?.remove();
    };
    if (hasConsent('media')) load();
    onConsent((c) => c.media && load());
    box.querySelector('[data-gmap-load]')?.addEventListener('click', () => saveConsent({ ...readConsent(), media: true }));
  });
</script>
