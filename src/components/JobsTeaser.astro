---
import Icon from './Icon.astro';
import Diagonal from './Diagonal.astro';
---

<Diagonal from="white" to="stone" line={false} />
<section class="bg-stone py-14 sm:py-16" aria-labelledby="jobs-teaser">
  <div class="container-x flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p class="kicker text-bronze-700">Jobs</p>
      <h2 id="jobs-teaser" class="text-3xl sm:text-4xl">Anpacken im Tiefbau? Komm zu uns.</h2>
      <p class="mt-4 text-lg text-muted">
        Du arbeitest gern draussen, mit Maschinen und in einem kleinen Team, in dem man sich kennt? Dann melde dich – eine Kurzbewerbung dauert zwei Minuten.
      </p>
    </div>
    <a href="/jobs/" class="btn-outline-dark shrink-0">
      Offene Stellen <Icon name="arrow" class="size-5" />
    </a>
  </div>
</section>
