---
import '../styles/global.css';
import barlow400 from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import barlowCond700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import { site } from '../config/site';
import { organisationSchema, breadcrumbSchema } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  /** max. 60 Zeichen */
  title: string;
  /** max. 155 Zeichen */
  description: string;
  noindex?: boolean;
  ogImage?: string;
  breadcrumbs?: { name: string; path: string }[];
  schema?: object[];
}

const { title, description, noindex = false, ogImage = '/og-image.png', breadcrumbs, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const jsonLd = [organisationSchema(), ...(breadcrumbs ? [breadcrumbSchema(breadcrumbs)] : []), ...schema];
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href={barlow400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={barlowCond700} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1a1a" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>

  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#inhalt"
      class="sr-only z-50 bg-bronze px-4 py-3 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Zum Inhalt springen
    </a>
    <CookieBanner />
    <Header />
    <main id="inhalt" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      // Sektionen mit [data-animate]: Startzustand setzen (is-armed), beim Sichtbarwerden abspielen (is-active).
      // Ohne JS oder bei «Bewegung reduzieren» bleibt alles im Endzustand.
      const animated = document.querySelectorAll<HTMLElement>('[data-animate]');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const aio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-active');
                aio.unobserve(e.target);
              }
            }
          },
          // Auslösen, sobald die Oberkante ~15 % ins Bild ragt – funktioniert auch bei sehr hohen Elementen (Mobile)
          { threshold: 0, rootMargin: '0px 0px -15% 0px' },
        );
        animated.forEach((el) => {
          el.classList.add('is-armed');
          aio.observe(el);
        });
      }

      // Dezentes Einblenden beim Scrollen
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
